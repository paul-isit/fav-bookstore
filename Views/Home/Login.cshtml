@{
    ViewData["Title"] = "Login | Favourite Books";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login | Favourite Books</title>
  <link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>
  <header class="site-header">
    <a class="brand" href="@Url.Action("Index", "Home")#home">Favourite Books</a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="@Url.Action("Index", "Home")#catalogue">Catalogue</a>
      <a href="@Url.Action("Cart", "Home")">Cart <span id="cart-count">0</span></a>
      <span id="session-status" class="session-status" hidden></span>
      <button id="sign-out-button" class="ghost-button compact-button" type="button" hidden>Sign out</button>
      <a id="login-link" href="@Url.Action("Login", "Home")">Login</a>
      <a id="signup-link" class="button-link" href="@Url.Action("Signup", "Home")">Sign up</a>
    </nav>
  </header>

  <main class="auth-page">
    <section class="auth-copy">
      <p class="eyebrow">Welcome back</p>
      <h1>Login</h1>
      <p class="muted">Use your customer account or continue as a guest shopper.</p>
    </section>

    <form id="login-form" class="form-panel auth-form">
      <label for="login-email">Email</label>
      <input id="login-email" type="email" placeholder="you@example.com" required />

      <label for="login-password">Password</label>
      <input id="login-password" type="password" placeholder="Password" required />

      <button class="button" type="submit">Login</button>
      <button id="guest-login-button" class="ghost-button" type="button">Continue as guest</button>
      <p id="login-message" class="muted"></p>
      <p class="muted">No account yet? <a href="@Url.Action("Signup", "Home")">Sign up here</a>.</p>
    </form>
  </main>

  <script src="~/js/account.js" asp-append-version="true"></script>
</body>
</html>
